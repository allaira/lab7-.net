<Window x:Class="ConveyorSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система 'Конвеєрна лінія'" Height="500" Width="700"
        Background="#E8F5E9" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель керування -->
        <GroupBox Header="Панель керування конвеєром" Grid.Row="0" Margin="0,0,0,10"
                  FontSize="14" FontWeight="Bold" Foreground="#1B5E20" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Вага на лінії (кг):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtWeight" Width="120" Height="30" VerticalContentAlignment="Center"
                         FontSize="14" Margin="0,0,15,0" Text="115"/>
                <Button x:Name="BtnCheck" Content="Перевірити навантаження" Width="200" Height="35"
                        Background="#B71C1C" Foreground="White" FontWeight="Bold"
                        Click="BtnCheck_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Журнал подій -->
        <GroupBox Header="Журнал подій (Лог систем)" Grid.Row="1"
                  FontSize="14" FontWeight="Bold" Foreground="#1B5E20" Padding="10">
            <ListBox x:Name="LstLog" FontFamily="Consolas" FontSize="13" Background="White"/>
        </GroupBox>
    </Grid>
</Window>